# Standalone environment variables for fundconnect-ibkr-bot.
# Place in ~/.config/fundconnect-bot/env (chmod 600 ~/.config/fundconnect-bot/env) or ./.env;
# NEVER commit real keys.

INDEXONE_API_KEY=replace_with_your_indexone_api_key
TUSHARE_TOKEN=replace_with_your_tushare_pro_token
CRYPTORACLE_API_KEY=replace_with_your_cryptoracle_api_key

# IBKR TWS / IB Gateway socket settings
# Ports: 4002 = IB Gateway Paper, 4001 = IB Gateway Live, 7497 = TWS Paper, 7496 = TWS Live
# Market data types: 1 = Live, 2 = Frozen, 3 = Delayed, 4 = Delayed-Frozen (default: free 15m
# quotes when unsubscribed; automatically upgrades to Type-1 Live when subscribed)
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=26
IBKR_ACCOUNT=
IBKR_MARKET_DATA_TYPE=4
